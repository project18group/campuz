# Core Django settings
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DB_NAME=replace-me
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=replace-me
DB_PORT=5432

# Arkesel SMS / OTP
ARKESEL_API_KEY=replace-me
ARKESEL_SENDER_ID=Campuz

# Optional delivery webhook for SMS status tracking
# Use your public backend URL here, not a local-only address.
# Example: https://campuz-api.onrender.com/api/webhooks/sms/delivery/
ARKESEL_SMS_CALLBACK_URL=https://your-public-backend-domain/api/webhooks/sms/delivery/
